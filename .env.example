# Copy to .env and fill in. .env is gitignored — never commit real keys.

# data.gov.in Open Government Data platform.
# Register at https://data.gov.in/ to get one.
# NOTE: this API takes the key as a URL query parameter (their design, not ours),
# so keep it out of logged request URLs — see askbharat/config.py:redact().
DATA_GOV_API_KEY=

# OpenRouter — https://openrouter.ai/keys
# Free models are capped at 20 req/min and 50 req/day; a one-time $10 credit
# purchase raises the daily cap to 1000. The extraction job is sized around that.
OPENROUTER_API_KEY=

# Identifies our crawler to the sites we fetch. Point it at a real contact page.
CRAWLER_CONTACT=https://github.com/YOURNAME/askbharat

# Postgres
DATABASE_URL=postgresql+psycopg://askbharat:askbharat@localhost:5433/askbharat
