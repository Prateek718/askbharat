# Copy to .env and fill in. .env is gitignored — never commit real keys.

# data.gov.in Open Government Data platform.
# Register at https://data.gov.in/ to get one.
# NOTE: this API takes the key as a URL query parameter (their design, not ours),
# so keep it out of logged request URLs — see askbharat/config.py:redact().
DATA_GOV_API_KEY=

# OpenRouter — https://openrouter.ai/keys
# Free models are capped at 20 req/min and 50 req/day; a one-time $10 credit
# purchase raises the daily cap to 1000. The extraction job is sized around that.
OPENROUTER_API_KEY=

# Identifies our crawler to the sites we fetch. Point it at a real contact page.
CRAWLER_CONTACT=https://github.com/YOURNAME/askbharat

# Postgres
# The password below is a development default and is checked for by
# Settings.check_production_ready() — with APP_ENV=production, booting with it
# still set is reported as a configuration error at startup.
POSTGRES_USER=askbharat
POSTGRES_PASSWORD=askbharat
POSTGRES_DB=askbharat
# Host port for the dev database. 5433, not 5432, to avoid colliding with a
# local Postgres.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://askbharat:askbharat@localhost:5433/askbharat

# Serving
# development | production. Production disables /api/docs and turns on the
# startup configuration check. It never changes what the site says about a
# scheme — a citizen must not get a different answer per environment.
APP_ENV=development
# Loopback by default so a dev run is not silently reachable from the network.
# The container image sets 0.0.0.0, where the publish rule decides exposure.
HOST=127.0.0.1
PORT=8077
# Each worker loads its own bi-encoder and cross-encoder, ~1.1 GB resident.
# Two do not fit on a 7.2 GB box beside Postgres. Raise only where RAM allows.
WEB_CONCURRENCY=1
